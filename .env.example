# Copy this file to .env (which git ignores) and fill in what you need. Never commit real keys.

# ---- AI review (US-12) ----
# Which LLM reviews contract language. Leave empty (or "none") to use only the basic TF-IDF matcher.
#   openrouter  - hosted models through OpenRouter (current, sample contracts only)
#   anthropic   - Claude
#   gemini      - Google Gemini
LLM_PROVIDER=

# Optional: a model other than the provider's default
LLM_MODEL=

# Fill in only the key for the provider you are using
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---- Matrices and matcher (US-7) ----
# Paths are relative to the repository folder; leave empty to use the bundled matrices
AICR_FAR_MATRIX=
AICR_TNC_MATRIX=
# Similarity score (0-1) above which the basic matcher flags a sentence; default 0.20
AICR_SIMILARITY_THRESHOLD=
