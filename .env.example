# Copy this file to .env (which git ignores) and fill in what you need. Never commit real keys.

# ---- AI review (US-12) ----
# Required: the app scans contracts only with an AI provider. While LLM_PROVIDER or its key is empty,
# the workbench says the AI review is not set up and turns down every upload.
# Use a provider Auburn has approved for OSP contracts; a personal or free key is for sample contracts only.
# Recommended: gemini (docs/MODEL_RECOMMENDATION.md). IT: follow docs/IT_HANDOFF.md.
#   anthropic   - Claude
#   gemini      - Google Gemini
#   openrouter  - hosted models through OpenRouter (development on sample contracts only)
LLM_PROVIDER=

# Optional: a model other than the provider's default (gemini: gemini-flash-latest, anthropic: claude-sonnet-5-5,
# openrouter: a free NVIDIA model). For OSP use, set a fixed model version here, not an alias.
LLM_MODEL=

# Fill in only the key for the provider you are using
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional limits on each AI request (leave empty for the defaults)
# Seconds to wait for the provider before the scan fails; default 300
LLM_TIMEOUT_SECONDS=
# Output limit of a reply in tokens; default 16000 for Claude, the provider's own default otherwise.
# Raise it if scans fail with "cut off before it finished".
LLM_MAX_TOKENS=
# How much the model may think before answering: low, medium or high; default: the model's own
LLM_EFFORT=

# ---- Finished scans ----
# Minutes a finished scan's results and annotated copy stay in memory before the server forgets them; default 120
AICR_SCAN_RETENTION_MINUTES=

# ---- Matrices (US-7) ----
# Paths are relative to the repository folder; leave empty to use the bundled matrices
AICR_FAR_MATRIX=
AICR_TNC_MATRIX=
